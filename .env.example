# development | production (production enables gin release mode, HSTS, and hides ad placeholders)
APP_ENV=development
PORT=8080
# Public origin, used for canonical URLs, Open Graph, robots.txt and the sitemap.
# In production it must be your https domain (e.g. https://taptimer.app); other
# hosts (www., the platform's default domain) are 301-redirected to it.
BASE_URL=http://localhost:8080

# App Store funnel
APP_STORE_ID=6802904982
# App Store Connect > App Analytics > Campaigns: your provider token (pt).
# When set, every /get?src=<placement> redirect is attributed as campaign "web-<placement>".
APP_STORE_PROVIDER_TOKEN=

# Google AdSense (leave ADSENSE_CLIENT empty to disable ads entirely)
ADSENSE_CLIENT=
ADSENSE_SLOT_SIDEBAR=
ADSENSE_SLOT_INCONTENT=
ADSENSE_SLOT_FOOTER=

# Optional
GA_MEASUREMENT_ID=
CONTACT_EMAIL=

# Optional search-engine verification (the token only, not the whole <meta> tag).
# Google Search Console > Add property > URL prefix > HTML tag
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools > Add site > HTML Meta Tag (msvalidate.01)
BING_SITE_VERIFICATION=
