# Copy to .env for local runs: the app reads it at startup (your terminal's
# variables win). .env never goes to git or the Docker image.

# development | production (production enables gin release mode, HSTS, and hides ad placeholders)
APP_ENV=development
PORT=8080
# Public origin, used for canonical URLs, Open Graph, robots.txt and the sitemap.
# In production it must be your https domain (e.g. https://tap-timer.com); other
# hosts (www., the platform's default domain) are 301-redirected to it.
BASE_URL=http://localhost:8080

# App Store funnel
APP_STORE_ID=6802904982
# App Store Connect > App Analytics > Campaigns: your provider token (pt).
# When set, every /get?src=<placement> redirect is attributed as campaign "web-<placement>".
APP_STORE_PROVIDER_TOKEN=

# Google AdSense (leave ADSENSE_CLIENT empty to disable ads entirely)
ADSENSE_CLIENT=
ADSENSE_SLOT_SIDEBAR=
ADSENSE_SLOT_INCONTENT=
ADSENSE_SLOT_FOOTER=

# Optional
GA_MEASUREMENT_ID=
# Shown on /privacy; without it the page points to the App Store listing.
CONTACT_EMAIL=

# Online multiplayer: most players connected at once (default 900). Keep it
# ~100 below fly.toml's hard_limit so pages still load when rooms are full.
# ONLINE_MAX_PLAYERS=900

# Optional search-engine verification (the token only, not the whole <meta> tag).
# Google Search Console > Add property > URL prefix > HTML tag
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools > Add site > HTML Meta Tag (msvalidate.01)
BING_SITE_VERIFICATION=

# Studio (/studio): private dashboard for posting to Shorts, Reels and TikTok.
# Off unless STUDIO_PASSWORD is set. No database. Setup: doc/studio.md
STUDIO_PASSWORD=
# 32+ random characters (openssl rand -hex 32). Signs the login cookie.
STUDIO_SECRET=
# "Today" for the daily streak.
STUDIO_TZ=America/Chicago
# Developer apps. For YouTube you can instead put Google's client JSON in secrets/.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
# Optional: a Facebook Login for Business configuration id (Meta recommends it over scopes).
META_LOGIN_CONFIG_ID=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Saved logins. Connecting in the studio gives you the value; locally it's
# written to secrets/<NAME> for you instead.
YOUTUBE_REFRESH_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
